<Page
	x:Class="Files.App.Views.Settings.LayoutPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:uc="using:Files.App.UserControls"
	xmlns:vm="using:Files.App.ViewModels.Settings"
	xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary>
			<Style x:Key="Local.SectionHeaderStyle" TargetType="TextBlock">
				<Setter Property="FontSize" Value="16" />
				<Setter Property="FontWeight" Value="Medium" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
		</ResourceDictionary>
	</Page.Resources>

	<Page.DataContext>
		<vm:LayoutViewModel x:Name="ViewModel" />
	</Page.DataContext>

	<StackPanel
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch"
		Spacing="4">

		<!--  Title  -->
		<TextBlock
			Padding="0,0,0,12"
			AutomationProperties.HeadingLevel="Level1"
			Style="{StaticResource App.Theme.SubtitleTextBlockStyle}"
			Text="{helpers:ResourceString Name=Layout}" />

		<!--  Templates  -->
		<wctcontrols:SettingsExpander
			Header="{helpers:ResourceString Name=LayoutTemplates}"
			IsExpanded="True"
			ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}">
			<wctcontrols:SettingsExpander.HeaderIcon>
				<FontIcon Glyph="&#xE8BA;" />
			</wctcontrols:SettingsExpander.HeaderIcon>

			<SplitButton Command="{x:Bind ViewModel.AddTemplateCommand}" Content="{helpers:ResourceString Name=AddTemplate}">
				<SplitButton.Flyout>
					<MenuFlyout Placement="Bottom">
						<MenuFlyoutItem Command="{x:Bind ViewModel.ResetTemplatesCommand}" Text="{helpers:ResourceString Name=ResetTemplates}" />
					</MenuFlyout>
				</SplitButton.Flyout>
			</SplitButton>

			<wctcontrols:SettingsExpander.ItemTemplate>
				<DataTemplate x:DataType="vm:LayoutTemplateViewModel">
					<wctcontrols:SettingsCard
						ActionIconToolTip="{helpers:ResourceString Name=Edit}"
						AutomationProperties.Name="{x:Bind EditName, Mode=OneWay}"
						Command="{x:Bind EditCommand}"
						Header="{x:Bind DisplayName, Mode=OneWay}"
						IsClickEnabled="True">
						<Button
							AutomationProperties.Name="{x:Bind DeleteName, Mode=OneWay}"
							Command="{x:Bind DeleteCommand}"
							Content="{helpers:ResourceString Name=Delete}"
							IsEnabled="{x:Bind CanDelete, Mode=OneWay}" />
					</wctcontrols:SettingsCard>
				</DataTemplate>
			</wctcontrols:SettingsExpander.ItemTemplate>
		</wctcontrols:SettingsExpander>

		<!--  Details View  -->
		<TextBlock
			Padding="0,16,0,4"
			Style="{StaticResource Local.SectionHeaderStyle}"
			Text="{helpers:ResourceString Name=DetailsView}" />

		<!--  Auto-fit Columns  -->
		<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=AutoSizeColumnsInDetailsLayout}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xE784;" />
			</wctcontrols:SettingsCard.HeaderIcon>
			<ToggleSwitch AutomationProperties.Name="{helpers:ResourceString Name=AutoSizeColumnsInDetailsLayout}" IsOn="{x:Bind ViewModel.AutoSizeColumnsInDetailsLayout, Mode=TwoWay}" />
		</wctcontrols:SettingsCard>

	</StackPanel>
</Page>
