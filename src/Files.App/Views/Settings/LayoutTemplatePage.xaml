<Page
	x:Class="Files.App.Views.Settings.LayoutTemplatePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.Settings"
	xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d">

	<Page.Resources>
		<Style x:Key="Local.SectionHeaderStyle" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,12,0,4" />
		</Style>

		<Style
			x:Key="Local.SubtleIconButtonStyle"
			BasedOn="{StaticResource DefaultButtonStyle}"
			TargetType="Button">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<Style
			x:Key="Local.IconButtonStyle"
			BasedOn="{StaticResource DefaultButtonStyle}"
			TargetType="Button">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Padding" Value="0" />
		</Style>

		<Style
			x:Key="Local.ListItemStyle"
			BasedOn="{StaticResource DefaultListViewItemStyle}"
			TargetType="ListViewItem">
			<Setter Property="MinHeight" Value="36" />
			<Setter Property="Padding" Value="16,0" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		</Style>
	</Page.Resources>

	<StackPanel Spacing="4">

		<!--  Title  -->
		<StackPanel
			Padding="0,0,0,12"
			Orientation="Horizontal"
			Spacing="8">
			<TextBlock Style="{StaticResource App.Theme.SubtitleTextBlockStyle}">
				<Hyperlink
					Click="LayoutBreadcrumb_Click"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					UnderlineStyle="None">
					<Run Text="{helpers:ResourceString Name=Layout}" />
				</Hyperlink>
			</TextBlock>
			<FontIcon
				VerticalAlignment="Center"
				AutomationProperties.AccessibilityView="Raw"
				FontSize="14"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Glyph="&#xE76C;" />
			<TextBlock
				AutomationProperties.HeadingLevel="Level1"
				Style="{StaticResource App.Theme.SubtitleTextBlockStyle}"
				Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
				TextTrimming="CharacterEllipsis" />
		</StackPanel>

		<!--  Name  -->
		<wctcontrols:SettingsCard Description="{x:Bind ViewModel.DisplayName, Mode=OneWay}" Header="{helpers:ResourceString Name=TemplateName}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xE8AC;" />
			</wctcontrols:SettingsCard.HeaderIcon>
			<Button
				AutomationProperties.Name="{x:Bind ViewModel.RenameName, Mode=OneWay}"
				Click="Rename_Click"
				Content="{helpers:ResourceString Name=Rename}" />
		</wctcontrols:SettingsCard>
		<!--  Use for file types  -->
		<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=UseForFileTypes}" Visibility="{x:Bind ViewModel.CanTurnOnFileTypes, Mode=OneWay}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xE8A5;" />
			</wctcontrols:SettingsCard.HeaderIcon>
			<ToggleSwitch
				AutomationProperties.Name="{helpers:ResourceString Name=UseForFileTypes}"
				IsOn="{x:Bind ViewModel.IsUsedForFileTypes, Mode=OneWay}"
				Toggled="UseForFileTypes_Toggled" />
		</wctcontrols:SettingsCard>
		<wctcontrols:SettingsExpander
			Header="{helpers:ResourceString Name=UseForFileTypes}"
			IsExpanded="{x:Bind ViewModel.IsUsedForFileTypes, Mode=OneWay}"
			Visibility="{x:Bind ViewModel.IsUsedForFileTypes, Mode=OneWay}">
			<wctcontrols:SettingsExpander.HeaderIcon>
				<FontIcon Glyph="&#xE8A5;" />
			</wctcontrols:SettingsExpander.HeaderIcon>

			<ToggleSwitch
				AutomationProperties.Name="{helpers:ResourceString Name=UseForFileTypes}"
				IsOn="{x:Bind ViewModel.IsUsedForFileTypes, Mode=OneWay}"
				Toggled="UseForFileTypes_Toggled" />

			<wctcontrols:SettingsExpander.Items>
				<wctcontrols:SettingsCard Description="{x:Bind ViewModel.FileTypesSummary, Mode=OneWay}" Header="{helpers:ResourceString Name=FileTypes}">
					<Button
						AutomationProperties.Name="{helpers:ResourceString Name=EditFileTypes}"
						Command="{x:Bind ViewModel.EditFileTypesCommand}"
						Content="{helpers:ResourceString Name=Edit}" />
				</wctcontrols:SettingsCard>
				<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=FileTypesThreshold}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<NumberBox
							MinWidth="96"
							AutomationProperties.Name="{helpers:ResourceString Name=FileTypesThreshold}"
							Maximum="100"
							Minimum="1"
							SmallChange="10"
							SpinButtonPlacementMode="Compact"
							Value="{x:Bind ViewModel.FileTypesThreshold, Mode=TwoWay}" />
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AccessibilityView="Raw"
							Text="%" />
					</StackPanel>
				</wctcontrols:SettingsCard>
			</wctcontrols:SettingsExpander.Items>
		</wctcontrols:SettingsExpander>

		<!--  Layout  -->
		<TextBlock
			AutomationProperties.HeadingLevel="Level2"
			Style="{StaticResource Local.SectionHeaderStyle}"
			Text="{helpers:ResourceString Name=Layout}" />

		<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=LayoutType}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xE8BA;" />
			</wctcontrols:SettingsCard.HeaderIcon>
			<ComboBox
				MinWidth="160"
				AutomationProperties.Name="{helpers:ResourceString Name=LayoutType}"
				SelectedIndex="{x:Bind ViewModel.SelectedLayoutModeIndex, Mode=TwoWay}">
				<ComboBoxItem Content="{helpers:ResourceString Name=Details}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=List}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=Cards}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=Columns}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=Grid}" />
			</ComboBox>
		</wctcontrols:SettingsCard>

		<!--  Columns  -->
		<wctcontrols:SettingsExpander
			Header="{helpers:ResourceString Name=Columns}"
			IsExpanded="True"
			Visibility="{x:Bind ViewModel.IsDetailsLayout, Mode=OneWay}">
			<wctcontrols:SettingsExpander.HeaderIcon>
				<FontIcon Glyph="&#xE71D;" />
			</wctcontrols:SettingsExpander.HeaderIcon>

			<DropDownButton AutomationProperties.Name="{helpers:ResourceString Name=AddColumn}" Content="{helpers:ResourceString Name=AddColumn}">
				<DropDownButton.Flyout>
					<Flyout Opening="AddColumnFlyout_Opening" Placement="BottomEdgeAlignedRight">
						<Grid
							Width="300"
							MaxHeight="420"
							RowSpacing="8">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<TextBox
								x:Name="ColumnSearchBox"
								AutomationProperties.Name="{helpers:ResourceString Name=SearchColumns}"
								PlaceholderText="{helpers:ResourceString Name=SearchColumns}"
								Text="{x:Bind ViewModel.Columns.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							<ListView
								Grid.Row="1"
								AutomationProperties.Name="{helpers:ResourceString Name=AvailableColumns}"
								IsItemClickEnabled="True"
								ItemClick="AvailableColumns_ItemClick"
								ItemsSource="{x:Bind ViewModel.Columns.AvailableColumnList, Mode=OneWay}"
								SelectionMode="None">
								<ListView.ItemTemplate>
									<DataTemplate x:DataType="vm:ColumnTreeItem">
										<Grid AutomationProperties.Name="{x:Bind DisplayName}">
											<TextBlock
												Margin="0,8,0,2"
												FontWeight="SemiBold"
												Foreground="{ThemeResource TextFillColorSecondaryBrush}"
												Style="{StaticResource App.Theme.CaptionTextBlockStyle}"
												Text="{x:Bind DisplayName}"
												Visibility="{x:Bind IsGroup}" />
											<Grid ColumnSpacing="8" Visibility="{x:Bind IsColumn}">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>
												<TextBlock
													VerticalAlignment="Center"
													Text="{x:Bind DisplayName}"
													TextTrimming="CharacterEllipsis" />
												<FontIcon
													Grid.Column="1"
													AutomationProperties.AccessibilityView="Raw"
													FontSize="12"
													Foreground="{ThemeResource TextFillColorSecondaryBrush}"
													Glyph="&#xE710;" />
											</Grid>
										</Grid>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</Grid>
					</Flyout>
				</DropDownButton.Flyout>
			</DropDownButton>

			<wctcontrols:SettingsExpander.ItemsHeader>
				<Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
					<ListView
						Padding="0,4"
						AllowDrop="True"
						AutomationProperties.Name="{helpers:ResourceString Name=ShownColumns}"
						CanDragItems="True"
						CanReorderItems="True"
						DragItemsCompleted="ColumnsList_DragItemsCompleted"
						DragItemsStarting="ColumnsList_DragItemsStarting"
						ItemContainerStyle="{StaticResource Local.ListItemStyle}"
						ItemsSource="{x:Bind ViewModel.Columns.ShownColumns, Mode=OneWay}"
						ScrollViewer.VerticalScrollBarVisibility="Disabled"
						ScrollViewer.VerticalScrollMode="Disabled"
						SelectionMode="None">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="vm:ColumnListItem">
								<Grid
									MinHeight="40"
									AutomationProperties.Name="{x:Bind DisplayName}"
									ColumnSpacing="12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="16" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<PathIcon
										Width="12"
										VerticalAlignment="Center"
										AutomationProperties.AccessibilityView="Raw"
										Data="{StaticResource App.Theme.PathIcon.DragGripper}"
										Visibility="{x:Bind IsMovable}" />
									<FontIcon
										AutomationProperties.AccessibilityView="Raw"
										FontSize="12"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Glyph="&#xE72E;"
										ToolTipService.ToolTip="{helpers:ResourceString Name=AlwaysShown}"
										Visibility="{x:Bind IsPinned}" />

									<TextBlock
										Grid.Column="1"
										VerticalAlignment="Center"
										Text="{x:Bind DisplayName}"
										TextTrimming="CharacterEllipsis" />

									<StackPanel
										Grid.Column="2"
										Orientation="Horizontal"
										Spacing="2"
										Visibility="{x:Bind IsMovable}">
										<Button
											AutomationProperties.Name="{x:Bind MoveUpName}"
											Click="MoveColumnUp_Click"
											Style="{StaticResource Local.SubtleIconButtonStyle}"
											ToolTipService.ToolTip="{helpers:ResourceString Name=MoveUp}">
											<FontIcon FontSize="12" Glyph="&#xE70E;" />
										</Button>
										<Button
											AutomationProperties.Name="{x:Bind MoveDownName}"
											Click="MoveColumnDown_Click"
											Style="{StaticResource Local.SubtleIconButtonStyle}"
											ToolTipService.ToolTip="{helpers:ResourceString Name=MoveDown}">
											<FontIcon FontSize="12" Glyph="&#xE70D;" />
										</Button>
										<Button
											AutomationProperties.Name="{x:Bind RemoveName}"
											Click="RemoveColumn_Click"
											Style="{StaticResource Local.SubtleIconButtonStyle}"
											ToolTipService.ToolTip="{helpers:ResourceString Name=Remove}">
											<FontIcon FontSize="12" Glyph="&#xE711;" />
										</Button>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
				</Grid>
			</wctcontrols:SettingsExpander.ItemsHeader>
		</wctcontrols:SettingsExpander>

		<!--  Sorting and grouping  -->
		<TextBlock
			AutomationProperties.HeadingLevel="Level2"
			Style="{StaticResource Local.SectionHeaderStyle}"
			Text="{helpers:ResourceString Name=SortingAndGrouping}" />

		<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=SortBy}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xE8CB;" />
			</wctcontrols:SettingsCard.HeaderIcon>
			<StackPanel Orientation="Horizontal" Spacing="8">
				<DropDownButton
					MinWidth="200"
					HorizontalContentAlignment="Left"
					AutomationProperties.Name="{helpers:ResourceString Name=SortBy}"
					Content="{x:Bind ViewModel.SortPicker.Text, Mode=OneWay}">
					<DropDownButton.Flyout>
						<Flyout
							x:Name="SortPickerFlyout"
							Opening="PropertyPickerFlyout_Opening"
							Placement="BottomEdgeAlignedLeft">
							<Grid
								Width="280"
								MaxHeight="420"
								RowSpacing="8"
								Tag="{x:Bind ViewModel.SortPicker, Mode=OneWay}">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<TextBox
									AutomationProperties.Name="{helpers:ResourceString Name=Search}"
									PlaceholderText="{helpers:ResourceString Name=Search}"
									Tag="{x:Bind ViewModel.SortPicker, Mode=OneWay}"
									TextChanged="PropertyPickerSearch_TextChanged" />
								<ListView
									Grid.Row="1"
									AutomationProperties.Name="{helpers:ResourceString Name=SortBy}"
									IsItemClickEnabled="True"
									ItemClick="PropertyPicker_ItemClick"
									ItemsSource="{x:Bind ViewModel.SortPicker.Suggestions, Mode=OneWay}"
									SelectionMode="None"
									Tag="{x:Bind ViewModel.SortPicker, Mode=OneWay}" />
							</Grid>
						</Flyout>
					</DropDownButton.Flyout>
				</DropDownButton>
				<ComboBox
					Width="130"
					AutomationProperties.Name="{helpers:ResourceString Name=SortDirection}"
					SelectedIndex="{x:Bind ViewModel.SelectedSortDirectionIndex, Mode=TwoWay}">
					<ComboBoxItem Content="{helpers:ResourceString Name=Ascending}" />
					<ComboBoxItem Content="{helpers:ResourceString Name=Descending}" />
				</ComboBox>
			</StackPanel>
		</wctcontrols:SettingsCard>

		<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=SortPriority}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xE8B7;" />
			</wctcontrols:SettingsCard.HeaderIcon>
			<ComboBox
				MinWidth="160"
				AutomationProperties.Name="{helpers:ResourceString Name=SortPriority}"
				SelectedIndex="{x:Bind ViewModel.SelectedSortPriorityIndex, Mode=TwoWay}">
				<ComboBoxItem Content="{helpers:ResourceString Name=SortFoldersFirst}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=SortFilesFirst}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=SortFilesAndFoldersTogether}" />
			</ComboBox>
		</wctcontrols:SettingsCard>

		<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=GroupBy}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xF168;" />
			</wctcontrols:SettingsCard.HeaderIcon>
			<StackPanel Orientation="Horizontal" Spacing="8">
				<DropDownButton
					MinWidth="200"
					HorizontalContentAlignment="Left"
					AutomationProperties.Name="{helpers:ResourceString Name=GroupBy}"
					Content="{x:Bind ViewModel.GroupPicker.Text, Mode=OneWay}">
					<DropDownButton.Flyout>
						<Flyout
							x:Name="GroupPickerFlyout"
							Opening="PropertyPickerFlyout_Opening"
							Placement="BottomEdgeAlignedLeft">
							<Grid
								Width="280"
								MaxHeight="420"
								RowSpacing="8"
								Tag="{x:Bind ViewModel.GroupPicker, Mode=OneWay}">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<TextBox
									AutomationProperties.Name="{helpers:ResourceString Name=Search}"
									PlaceholderText="{helpers:ResourceString Name=Search}"
									Tag="{x:Bind ViewModel.GroupPicker, Mode=OneWay}"
									TextChanged="PropertyPickerSearch_TextChanged" />
								<ListView
									Grid.Row="1"
									AutomationProperties.Name="{helpers:ResourceString Name=GroupBy}"
									IsItemClickEnabled="True"
									ItemClick="PropertyPicker_ItemClick"
									ItemsSource="{x:Bind ViewModel.GroupPicker.Suggestions, Mode=OneWay}"
									SelectionMode="None"
									Tag="{x:Bind ViewModel.GroupPicker, Mode=OneWay}" />
							</Grid>
						</Flyout>
					</DropDownButton.Flyout>
				</DropDownButton>
				<ComboBox
					Width="130"
					AutomationProperties.Name="{helpers:ResourceString Name=GroupDirection}"
					IsEnabled="{x:Bind ViewModel.IsGrouped, Mode=OneWay}"
					SelectedIndex="{x:Bind ViewModel.SelectedGroupDirectionIndex, Mode=TwoWay}">
					<ComboBoxItem Content="{helpers:ResourceString Name=Ascending}" />
					<ComboBoxItem Content="{helpers:ResourceString Name=Descending}" />
				</ComboBox>
			</StackPanel>
		</wctcontrols:SettingsCard>

		<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=GroupByDateUnit}" Visibility="{x:Bind ViewModel.IsGroupByDate, Mode=OneWay}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xE787;" />
			</wctcontrols:SettingsCard.HeaderIcon>
			<ComboBox
				MinWidth="160"
				AutomationProperties.Name="{helpers:ResourceString Name=GroupByDateUnit}"
				SelectedIndex="{x:Bind ViewModel.SelectedGroupByDateUnitIndex, Mode=TwoWay}">
				<ComboBoxItem Content="{helpers:ResourceString Name=Year}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=Month}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=Day}" />
			</ComboBox>
		</wctcontrols:SettingsCard>

		<!--  Restore defaults  -->
		<wctcontrols:SettingsCard
			Command="{x:Bind ViewModel.RestoreDefaultsCommand}"
			Header="{helpers:ResourceString Name=RestoreDefaults}"
			IsActionIconVisible="False"
			IsClickEnabled="True"
			Visibility="{x:Bind ViewModel.IsDefault}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xE777;" />
			</wctcontrols:SettingsCard.HeaderIcon>
		</wctcontrols:SettingsCard>

		<!--  Delete  -->
		<wctcontrols:SettingsCard
			AutomationProperties.Name="{x:Bind ViewModel.DeleteName, Mode=OneWay}"
			Click="DeleteCard_Click"
			Header="{helpers:ResourceString Name=DeleteTemplate}"
			IsActionIconVisible="False"
			IsClickEnabled="True"
			Visibility="{x:Bind ViewModel.CanHaveConditions}">
			<wctcontrols:SettingsCard.HeaderIcon>
				<FontIcon Glyph="&#xE74D;" />
			</wctcontrols:SettingsCard.HeaderIcon>
		</wctcontrols:SettingsCard>
	</StackPanel>
</Page>
